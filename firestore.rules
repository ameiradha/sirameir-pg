rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWebApp(data) {
      return data.keys().hasAll(['id', 'title', 'url'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.url is string && data.url.size() <= 3000
        && (!('iconType' in data) || (data.iconType is string && data.iconType.size() <= 30))
        && (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 60))
        && (!('iconColor' in data) || (data.iconColor is string && data.iconColor.size() <= 40))
        && (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 1000000))
        && (!('order' in data) || data.order is number)
        && (!('clicks' in data) || data.clicks is number);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['siteName'])
        && data.siteName is string && data.siteName.size() <= 200
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 500));
    }

    match /apps/{appId} {
      allow read: if true;
      allow create, update: if isValidId(appId) && isValidWebApp(request.resource.data);
      allow delete: if isValidId(appId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isValidSettings(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
